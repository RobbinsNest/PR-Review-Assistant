# PR Review Assistant - environment template.
#
# Copy to .env and fill in the values for your deployment:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# Secrets: the LLM API key is NEVER committed.  Prefer the OS keyring or the
# settings page (masked) for interactive setups; for containers set
# LLM_API_KEY here (the file is gitignored).

# LLM provider (OpenAI-compatible). base_url MUST be a public https:// URL
# (private/loopback URLs are rejected by the settings API); model is the
# OpenAI-compatible model name.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Pinned public example PR used by the SPA quick-start button and offline
# integration tests (owner/repo/pull/N format).
EXAMPLE_PR=RobbinsNest/PR-Review-Assistant/pull/1

# Per-client-IP request limit (requests/minute, keyed on the direct peer IP).
# 0 is the safe misconfiguration fallback: it REJECTS every request (not
# "unlimited") - keep positive (default 10) for normal use.
RATE_LIMIT_PER_MIN=10

# Comma-separated CORS allowlist; empty = same-origin only.
CORS_ORIGINS=

# SQLite database path. Local dev default: data/analyses.db. When running
# the Docker image directly (make run / docker run --env-file .env), set the
# absolute container path /app/data/analyses.db so data persists on the
# prra-data volume; docker compose sets this automatically.
DATABASE_PATH=data/analyses.db
